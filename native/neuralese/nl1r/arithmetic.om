note Independent implementation from declared functions and actual transmitted bytes.
note No producer forward/gradient/summary function is linked into this judge.
fn jsender id ulong d ulong to void
for k ulong d
v = get JP add mul 4 d k
for j ulong 4
v = add v mul f64 and shr id j 1 get JP add mul j d k
end
put JH k jsoft v
end
end
fn jaffine d ulong to void
for j ulong 4
v = get JP add mul 9 d j
for k ulong d
v = add v mul get JH k get JP add mul 5 d add mul k 4 j
end
put JS j mul 0.5f64 add 1.0f64 jsoft v
end
end
fn jnonlinear to void
for k ulong 8
v = get JP add 39 k
for j ulong 3
v = add v mul get JH j get JP add 15 add mul j 8 k
end
put JU k jrelu v
end
for j ulong 4
v = get JP add 79 j
for k ulong 8
v = add v mul get JU k get JP add 47 add mul k 4 j
end
put JS j mul 0.5f64 add 1.0f64 jsoft v
end
end
fn jcodec to void
t = mul 3.0f64 get JH 0
a = jrelu sub t 1.0f64
b = jrelu sub t 2.0f64
put JS 0 sub a b
put JS 1 add sub t mul 2.0f64 a mul 2.0f64 b
put JS 2 get JH 1
put JS 3 get JH 2
end
fn jcapacitywire to void
arm = get JC 1
id = get JR 0
q = get JR 1
d = get JC 4
for i ulong 32
put JB i uchar 0
end
if eq arm 3
v = id
if eq q 3
v = xor v 1
end
if eq q 4
v = or and v 12 or shl and v 1 1 shr and v 2 1
end
if eq q 5
v = 0
end
put JB 0 uchar v
ret
end
if eq get JC 7 2
put JH 0 div f64 add mul and id 1 2 and shr id 1 1 3.0f64
put JH 1 f64 and shr id 2 1
put JH 2 f64 and shr id 3 1
else
jsender id d
end
for k ulong d
v = get JH k
if or eq q 1 eq q 2
f = 16.0f64
if eq q 2
f = 32.0f64
end
v = div f64 long add mul fabs v f 0.5f64 f
if lt get JH k 0.0f64
v = neg v
end
end
if and eq q 3 eq k 0
v = neg v
end
if eq q 5
v = 0.0f64
end
put JH k v
end
if eq q 4
v = get JH 0
put JH 0 get JH 1
put JH 1 v
end
for k ulong d
jstore k bitcast ulong get JH k
end
end
fn jcapacitydecode to void
if eq get JC 1 3
for j ulong 4
put JS j f64 and shr get JR 3 j 1
end
ret
end
for k ulong get JC 4
v = bitcast f64 jload k
if not le fabs v 1.0f64
jinvalid
end
put JH k v
end
if eq get JC 7 2
jcodec
else
if eq get JC 1 2
jnonlinear
else
jaffine get JC 4
end
end
end
fn jtaskwire to void
id = get JR 0
arm = get JR 49
variant = get JR 1
for i ulong 32
put JB i uchar 0
end
if or eq variant 2 eq arm 3
ret
end
if eq variant 1
id = rem add id 1 16
end
if eq arm 0
v = id
if eq get JC 1 1
v = jparity id
end
if eq get JC 1 2
v = shr id 2
end
put JB 0 uchar v
ret
end
if eq arm 4
for j ulong 4
put JB j uchar add and shr id j 1 48
end
ret
end
jsender id 4
v = ulong 0
for j ulong 4
if eq arm 1
code = ulong long add mul add get JH j 1.0f64 1.5f64 0.5f64
if gt code 3
code = 3
end
v = or v shl code mul j 2
else
if ge get JH j 0.0f64
v = or v shl 1 j
end
end
end
put JB 0 uchar v
end
fn jtaskdecode to void
arm = get JR 49
task = get JC 1
for j ulong 4
put JS j 0.0f64
end
if eq get JR 1 2
ret
end
if or eq arm 0 eq arm 4
id = get JR 3
if eq arm 4
id = 0
for j ulong 4
v = get JR add 3 j
if and ne v 48 ne v 49
jinvalid
end
id = or id shl sub v 48 j
end
end
if eq arm 4
if eq task 1
id = jparity id
end
if eq task 2
id = shr id 2
end
end
if eq task 2
id = or shl id 2 get JR 47
end
for j ulong 4
put JS j f64 and shr id j 1
end
ret
end
v = get JR 3
for j ulong 4
h = 0.0f64
if eq arm 1
code = and shr v mul j 2 3
h = div sub mul f64 code 2.0f64 3.0f64 3.0f64
end
if eq arm 2
h = sub mul f64 and shr v j 1 2.0f64 1.0f64
end
put JH j h
end
jaffine 4
if eq task 1
for j ulong 3
put JS add j 1 0.0f64
end
end
if eq task 2
for j ulong 2
put JS j f64 and shr get JR 47 j 1
end
end
end
