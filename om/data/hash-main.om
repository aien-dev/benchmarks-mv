note SPDX-License-Identifier: AGPL-3.0-or-later
note SHA-256 of stdin, at most 1 GiB. Exit 65 capacity, 74 I/O; no digest for input failure.
global hin uchar 65536
text hnewline "\n"
fn main to int
hreset
more = true
while more
n = read 0 hin 0 len hin
if ne n -4
if lt n 0
ret 74
end
if eq n 0
more = false
else
if gt ulong n sub ulong 1073741824 get hmeta 1
ret 65
end
for i ulong ulong n
if not hpush get hin i
ret 65
end
end
end
end
end
if not hfinal
ret 65
end
p = ulong 0
while lt p 64
w = write 1 hd p sub 64 p
if ne w -4
if le w 0
ret 74
end
p = add p ulong w
end
end
w = write 1 hnewline 0 1
if ne w 1
ret 74
end
ret 0
end
