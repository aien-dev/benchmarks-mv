note SPDX-License-Identifier: AGPL-3.0-or-later
note Native bench_verify_records. No process helpers, network or GPU operations.
global targets ulong 1024
fn main to int
sinit
put fr 0 L_dot
n = ulong 0
i = ulong 1
options = true
while lt i ulong argcnt
arg = sarg i
if and options soptinline arg L_root
put fr 0 ssub arg 7 sub slen arg 7
i = add i 1
else
if and options seq arg L_root
i = add i 1
if ge i ulong argcnt
swrite 2 L_usagehelp
ret 2
end
put fr 0 sarg i
else
if and options or seq arg L_help sshorthelp arg
swrite 1 L_usagehelp
ret 0
end
if and options eq slen arg 2
if and eq schar arg 0 45 eq schar arg 1 45
options = false
arg = 0
end
end
if ne arg 0
if and options gt slen arg 0
if eq schar arg 0 45
swrite 2 L_usagehelp
ret 2
end
end
if eq n len targets
ret 64
end
put targets n arg
n = add n 1
end
end
i = add i 1
end
end
if eq n 0
put targets 0 L_records
put targets 1 L_artifacts
n = ulong 2
end
for k ulong n
epath get targets k
end
for k ulong get estate 1
swrite 1 get defects k
swrite 1 L_newline
end
swrite 2 L_summary
swrite 2 suint get estate 2
swrite 2 L_summaryrecords
swrite 2 suint get estate 3
swrite 2 L_summarybundles
swrite 2 suint get estate 4
swrite 2 L_summaryfiles
swrite 2 suint get estate 1
swrite 2 L_summarydefects
if ne get estate 1 0
ret 1
end
ret 0
end
