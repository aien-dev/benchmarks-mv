note Native /proc process enumeration and resident-memory sampling. Discovery uses literal cmdline text.
global mpids ulong 65536
global mpcount ulong 1
global mperror long 1
global mpvalue ulong 2
note mpvalue: RSS KiB and binary64 MiB, valid only after mp_rss returns true.
global mpsnap ulong 7
note mpsnap: Rss, Pss, Pss_Dirty, Private_Dirty, Shared_Clean KiB, then Rss MiB and Pss MiB.
global mptree ulong 4096
global mptn ulong 1
global mptotal ulong 5
fn mpentry off ulong size ulong to bool
record = fdirlen off
if or lt record 20 gt record sub size off
ret false
end
p = add off 19
start = p
while lt p add off record
if eq get fdirbuf p 0
name = get sp 0
for i ulong sub p start
sbyte get fdirbuf add start i
end
raw = sdone name
if msnumber raw
pid = get msvalue 0
if and gt pid 0 le pid 4294967295
n = get mpcount 0
if eq n len mpids
put mperror 0 -27
ret false
end
put mpids n pid
put mpcount 0 add n 1
end
end
ret true
end
p = add p 1
end
ret false
end
fn mpdirs path ulong to bool
put mpcount 0 0
put mperror 0 0
fd = fopenread path
if lt fd 0
put mperror 0 get ferr 0
ret false
end
good = true
more = true
while more
r = getdnts int fd fdirbuf 0 len fdirbuf
if ne r -4
if lt r 0
put mperror 0 r
good = false
more = false
else
if eq r 0
more = false
else
p = ulong 0
while and good lt p ulong r
if lt sub ulong r p 20
good = false
else
mark = get sp 0
good = mpentry p ulong r
put sp 0 mark
if good
p = add p fdirlen p
end
end
end
if not good
more = false
end
end
end
end
end
r = fclose int fd
ret and good eq r 0
end
fn mppath pid ulong leaf ulong to ulong
ret spath spath mspath msword 15 suint pid leaf
end
fn mp_rss pid ulong to bool
put mpvalue 0 0
put mpvalue 1 0
raw = ftext mppath pid msword 16
if lt raw 0
ret false
end
if not mskb ulong raw msword 21
ret false
end
put mpvalue 0 get msvalue 0
put mpvalue 1 dfdiv df_from_u64 get msvalue 0 df_from_u64 1024
ret true
end
fn mp_find pattern ulong to ulong
if eq slen pattern 0
ret 0
end
if not mpdirs mspath msword 15
ret 0
end
found = ulong 0
for i ulong get mpcount 0
pid = get mpids i
if ne pid ulong getpid
mark = get sp 0
raw = ftext mppath pid msword 17
if ge raw 0
p = get sp 0
for k ulong slen ulong raw
c = schar ulong raw k
if eq c 0
c = uchar 32
end
sbyte c
end
cmdline = sdone p
if ge sfind cmdline pattern 0
if or eq found 0 lt pid found
found = pid
end
end
end
put sp 0 mark
end
end
ret found
end
fn mp_smaps pid ulong to bool
for i ulong len mpsnap
put mpsnap i 0
end
raw = ftext mppath pid msword 18
if lt raw 0
ret false
end
seen = false
for i ulong 5
name = msword add 22 i
field = msfield ulong raw name
if ne slen field 0
if not mskb ulong raw name
ret false
end
put mpsnap i get msvalue 0
seen = true
end
end
if not seen
ret false
end
put mpsnap 5 dfdiv df_from_u64 get mpsnap 0 df_from_u64 1024
put mpsnap 6 dfdiv df_from_u64 get mpsnap 1 df_from_u64 1024
ret true
end
fn mptadd pid ulong to bool
for i ulong get mptn 0
if eq get mptree i pid
ret true
end
end
n = get mptn 0
if eq n len mptree
put mperror 0 -27
ret false
end
put mptree n pid
put mptn 0 add n 1
ret true
end
fn mptchildren raw ulong to bool
start = ulong 0
inword = false
for i ulong add slen raw 1
split = eq i slen raw
if not split
split = swhite schar raw i
end
if split
if inword
tok = ssub raw start sub i start
if msnumber tok
child = get msvalue 0
if and gt child 0 le child 4294967295
if not mptadd child
ret false
end
end
end
inword = false
end
else
if not inword
start = i
inword = true
end
end
end
ret true
end
fn mp_tree pid ulong to bool
put mptn 0 0
put mperror 0 0
if or eq pid 0 gt pid 4294967295
ret false
end
put mptree 0 pid
put mptn 0 1
cursor = ulong 0
while lt cursor get mptn 0
parent = get mptree cursor
tdir = mppath parent msword 19
if mpdirs tdir
for i ulong get mpcount 0
tid = get mpids i
mark = get sp 0
cpath = spath spath tdir suint tid msword 20
raw = ftext cpath
if ge raw 0
if not mptchildren ulong raw
put sp 0 mark
ret false
end
end
put sp 0 mark
end
end
cursor = add cursor 1
end
ret true
end
fn mp_tree_smaps pid ulong to bool
for k ulong len mpsnap
put mpsnap k 0
end
for k ulong len mptotal
put mptotal k 0
end
if not mp_tree pid
ret false
end
found = false
for i ulong get mptn 0
mark = get sp 0
if mp_smaps get mptree i
for k ulong 5
put mptotal k add get mptotal k get mpsnap k
end
found = true
end
put sp 0 mark
end
for k ulong len mpsnap
put mpsnap k 0
end
if not found
ret false
end
for k ulong 5
put mpsnap k get mptotal k
end
put mpsnap 5 dfdiv df_from_u64 get mptotal 0 df_from_u64 1024
put mpsnap 6 dfdiv df_from_u64 get mptotal 1 df_from_u64 1024
ret true
end
