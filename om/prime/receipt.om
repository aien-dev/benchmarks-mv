if ok
ok = prseal int fd
end
c = fclose int fd
if or not ok ne c 0
ret 0
end
r = prrename tmp dst
if ne r 0
if or receipt ne r -17
ret 0
end
have = fhash dst
if or lt have 0 not seq ulong have digest
ret 0
end
