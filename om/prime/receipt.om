if ne r 0
ret 0
end
end
if not prsyncdir
ret 0
end
if receipt
put prstate 2 dst
put prstate 3 digest
end
ret digest
end
fn prcopy source ulong fd int to bool
srcfd = fopenread source
if lt srcfd 0
ret false
