if and ne r 0 ne r -17
ret 0
end
actual = fhash dst
if or lt actual 0 not seq ulong actual digest
ret 0
end
if eq r -17
removed = unlink sb soff tmp slen tmp
if ne removed 0
ret 0
end
end
if not prsyncdir
ret 0
end
ret digest
end
