global prsample ulong 4096
global prstats ulong 7
note prstatistics count samples computes n, median, min, max, mean, sample sd, cv.
fn prstatistics count ulong to bool
if or eq count 0 gt count len prsample
ret false
end
for i ulong count
j = i
while gt j 0
if le dfcmp get prsample sub j 1 get prsample j 0
j = ulong 0
else
x = get prsample j
put prsample j get prsample sub j 1
put prsample sub j 1 x
j = sub j 1
end
end
end
sum = ulong 0
for i ulong count
sum = dfadd sum get prsample i
end
mean = dfdiv sum df_from_u64 count
mid = get prsample div count 2
if eq rem count 2 0
mid = dfdiv dfadd mid get prsample sub div count 2 1 df_from_u64 2
end
variance = ulong 0
if gt count 1
for i ulong count
d = dfsub get prsample i mean
variance = dfadd variance dfmul d d
end
variance = dfdiv variance df_from_u64 sub count 1
end
sd = dfsqrt variance
cv = ulong 0
if ne dfcmp mean 0 0
cv = dfdiv sd mean
end
put prstats 0 count
put prstats 1 mid
put prstats 2 get prsample 0
put prstats 3 get prsample sub count 1
put prstats 4 mean
put prstats 5 sd
put prstats 6 cv
ret true
end
