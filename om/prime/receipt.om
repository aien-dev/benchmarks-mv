fn prresolve path ulong to ulong
if not fvalid path
ret 0
end
base = prcwd
if eq base 0
ret 0
end
if eq schar path 0 47
base = ssub path 0 1
end
put prres 0 base
put prres 1 path
put prres 2 0
while gt slen get prres 1 0
if not prcomponent
ret 0
end
end
ret get prres 0
end
fn prsetup path ulong to bool
