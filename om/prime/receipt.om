good = false
else
p = add p ulong w
end
end
end
end
end
end
end
c = fclose int srcfd
ret and good eq c 0
end
fn prblob source ulong to ulong
d = fhash source
if lt d 0
ret 0
end
digest = ulong d
dst = spath get prstate 1 digest
tmp = scat3 dst prlit 2 suint ulong monons
fd = pxopen tmp
if lt fd 0
ret 0
end
