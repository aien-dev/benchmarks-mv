rrheaders
p = get sp 0
sbyte 123
prstr 6 prlit 7
sbyte 44
prstr 8 prlit 9
sbyte 44
verdict = prlit 4
reason = prlit 85
if ne get rrconf 10 0
verdict = prlit 5
reason = get rrmeta 4
end
prstr 10 verdict
sbyte 44
prstr 11 reason
sbyte 44
sbyte 34
for i ulong len rrutc
sbyte get rrutc i
end
sbyte 34
sbyte 58
prquoted get rrhead 6
sbyte 44
prkey 12
sbyte 123
for i ulong get rrconf 0
if ne i 0
sbyte 44
end
prquoted get rrname i
sbyte 58
sappend get rrimpls i
end
sbyte 125
sbyte 44
prkey 13
sbyte 123
prmaybe 14 get rrconf 7
sbyte 44
prmaybe 15 get rrhead 5
sbyte 125
sbyte 44
prkey 16
rrhardware
sbyte 44
prkey 17
rrconditions
sbyte 44
prkey 18
rrcorrect
sbyte 44
prkey 19
rrprotocoljson
sbyte 44
prkey 20
sbyte 91
for i ulong get rrconf 11
if ne i 0
sbyte 44
end
sappend get rrrecord i
end
sbyte 93
sbyte 44
prkey 21
sappend get rrhead 0
sbyte 44
prkey 22
sbyte 91
for i ulong get rrmeta 0
if ne i 0
sbyte 44
end
prquoted get rrline i
end
sbyte 93
sbyte 44
prkey 23
sbyte 123
prkey 24
sbyte 91
for i ulong get rcstate 0
if ne i 0
sbyte 44
end
prquoted get rcargv i
end
sbyte 93
sbyte 125
sbyte 44
prstr 25 prlit 26
sbyte 125
sbyte 10
ret sdone p
end
fn rrrun to int
if not prsetup get rrconf 6
swrite 2 get rrconf 6
swrite 2 L_newline
ret 64
end
for i ulong get rrconf 0
r = fhash get rrpath i
if lt r 0
put rrconf 10 1
put rrmeta 4 pvkind 1
else
put rrhash i ulong r
end
end
if eq get rrconf 10 0
ok = rrprotocol
end
if eq get rrconf 10 99
swrite 2 prlit 84
swrite 2 L_newline
ret 74
end
receipt = rrreceipt
digest = prstore receipt true
if eq digest 0
ret 74
end
for i ulong get rrmeta 0
swrite 1 get rrline i
swrite 1 L_newline
end
swrite 1 get rrhead 0
swrite 1 L_newline
swrite 1 get prstate 2
swrite 1 L_newline
if ne get rrconf 10 0
ret 1
end
ret 0
end
text rvwords "verify ~: ~ limits, audit passes ~, ~ failures~ -> PASS\n~ -> FAIL\n~reference pi(1000000) = ~"
fn rvlit index ulong to ulong
p = get sp 0
n = ulong 0
for i ulong len rvwords
c = get rvwords i
if eq c 126
if eq n index
ret sdone p
end
n = add n 1
else
if eq n index
sbyte c
end
end
end
ret sdone p
end
fn rvsummary failures ulong to void
swrite 1 rvlit 0
swrite 1 get rrname 0
swrite 1 rvlit 1
swrite 1 suint get swstate 0
swrite 1 rvlit 2
swrite 1 suint get rrconf 5
swrite 1 rvlit 3
swrite 1 suint failures
swrite 1 rvlit 4
if eq failures 0
swrite 1 rvlit 5
else
swrite 1 rvlit 6
end
for i ulong get swstate 0
if eq get swvalues i 1000000
size = makebits 1000000
swrite 1 rvlit 7
swrite 1 suint countbits size 1000000
swrite 1 L_newline
end
end
end
fn rrloadreport to ulong
if not fexists get pxstate 3
ret 0
end
r = ftext get pxstate 3
if lt r 0
ret 0
end
s = ulong r
for i ulong slen s
put jb i schar s i
end
if not jparse slen s
ret 0
end
ret s
end
fn rrlaunch index ulong audit ulong to bool
path = get rrpath index
limit = get rrconf 3
seconds = get rrconf 12
timeout = get rrconf 9
ret pxrun path limit seconds audit timeout
end
fn rrsamplestats index ulong to ulong
n = get rrn index
if eq n 0
ret 0
end
start = mul index 256
for j ulong n
v = get rrsample add start j
put prsample j v
end
if not prstatistics n
ret 0
end
ret prstatsjson
end
fn rrleap year ulong to bool
if ne rem year 4 0
ret false
end
ret or ne rem year 100 0 eq rem year 400 0
end
text rrwhy " pass ~ odd ~ tail ~ expected_prime ~"
fn rrwhytext index ulong to void
n = ulong 0
for i ulong len rrwhy
c = get rrwhy i
if eq c 126
n = add n 1
else
if eq n index
sbyte c
end
end
end
end
fn rrreject code ulong to ulong
p = get sp 0
sappend pvkind code
if or eq code 16 eq code 17
for i ulong 4
rrwhytext i
digits = suint get pvresult add i 5
end
end
ret sdone p
end
