fn pvinit to void
p = get sp 0
n = ulong 0
for i ulong len pvwords
c = get pvwords i
if eq c 126
put pvcache n sdone p
n = add n 1
p = get sp 0
else
sbyte c
end
end
end
fn pvlit n ulong to ulong
ret get pvcache n
end
fn pvkind code ulong to ulong
if or lt code 1 gt code 17
ret pvlit 31
end
ret pvlit add code 24
end
fn pvuint s ulong to bool
if eq slen s 0
ret false
end
if and gt slen s 1 eq schar s 0 48
ret false
end
for i ulong slen s
if or lt schar s i 48 gt schar s i 57
