put pvline 3 get tgnum 0
ret pvlinetags get pvparts 4
end
fn pvlinetags s ulong to bool
n = ulong 0
start = ulong 0
for i ulong add slen s 1
split = eq i slen s
if not split
split = eq schar s i 44
end
if split
if ge n 3
ret false
