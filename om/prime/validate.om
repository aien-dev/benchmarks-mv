if not pvuint get pvline 6
ret false
end
put pvline 6 get tgnum 0
ret true
end
fn pvfield key ulong kind uchar to long
t = jlookup 0 pvlit key
if not jkind t kind
ret -1
end
ret t
end
fn pvstr key ulong to ulong
t = pvfield key 3
if lt t 0
ret 0
end
ret jstringval t
end
fn pvnum key ulong to bool
t = jlookup 0 pvlit key
if not junsigned t
ret false
