end
end
ret tgdecimal s
end
fn pvtag s ulong prefix ulong to ulong
if not sstarts s prefix
ret 0
end
v = ssub s slen prefix sub slen s slen prefix
if eq slen v 0
ret 0
end
for i ulong slen v
if eq schar v i 61
ret 0
end
end
ret v
end
fn pvtime s ulong to bool
point = slen s
for i ulong slen s
c = schar s i
if eq c 46
if ne point slen s
ret false
end
point = i
else
if or lt c 48 gt c 57
ret false
end
end
end
if or eq point 0 ne add point 7 slen s
ret false
end
ret df_parse s
end
fn pvparseline s ulong to bool
