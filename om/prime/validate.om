actual = get dfstate 0
ok = df_parse pvlit 43
if gt dfcmp df_abs dfsub actual get pvexpect 2 get dfstate 0 0
ret 7
end
ret 0
end
fn pvbitmap to ulong
pvbm = new uchar 625000 0
fd = fopenread get pxstate 4
if lt fd 0
ret 14
end
size = makebits get pvexpect 1
count = get pvexpect 3
if eq count 0
count = ulong 1
end
result = ulong 0
for pass ulong count
p = ulong 0
while and lt p size eq result 0
r = read int fd pvbm p sub size p
if ne r -4
if le r 0
result = ulong 15
else
p = add p ulong r
end
end
end
if eq result 0
r = comparebits pvbm size get pvexpect 1
if ne r 0
result = ulong 16
if ne get pvexpect 3 0
result = ulong 17
end
put pvresult 5 pass
for i ulong 3
put pvresult add i 6 get diff i
end
end
end
end
if eq result 0
r = read int fd fi 0 1
if ne r 0
result = ulong 15
end
end
closed = fclose int fd
if ne closed 0
ret 15
end
ret result
end
fn pvvalidate to ulong
for i ulong 9
put pvresult i 0
end
if ne get pxcode 0 0
ret 1
end
raw = ftext get pxstate 1
if lt raw 0
ret 5
end
s = ulong raw
put pvresult 2 s
if not pvutf8 s
ret 5
end
if ne get pvexpect 3 0
if ne slen s 0
ret 2
end
else
if eq slen s 0
ret 3
end
if eq schar s sub slen s 1 10
s = ssub s 0 sub slen s 1
end
put pvresult 2 s
for i ulong slen s
if eq schar s i 10
ret 4
end
end
if not pvparseline s
ret 5
end
end
raw = ftext get pxstate 3
if lt raw 0
ret 6
end
s = ulong raw
for i ulong slen s
put jb i schar s i
end
for i ulong len jcache
put jcache i 0
end
if not jparse slen s
ret 7
end
r = pvreport
if ne r 0
ret r
end
ret pvbitmap
end

fn pvutf8 s ulong to bool
for i ulong slen s
put jb i schar s i
end
put js 0 slen s
put js 1 0
put js 3 0
put js 4 0
while lt get js 1 get js 0
c = jpeek
jstep
if ge c 128
if not jutf8 c
ret false
end
end
end
ret true
end
