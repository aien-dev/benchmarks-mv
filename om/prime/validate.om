text pvwords "schema~aien-prime-race/impl-report/v1~status~COMPLETE~impl~label~algorithm~faithful~bits~threads~limit~mode~passes~elapsed_s~environment~min_seconds~build~aien-~audit~timed~yes~no~algorithm=~faithful=~bits=~exit_code~audit_stdout_line~no_stdout_line~multiple_stdout_lines~malformed_line~report_missing~bad_report~status_not_complete~label_mismatch~line_report_mismatch~passes_zero~elapsed_below_min~audit_pass_count~bitmap_missing~bitmap_length~bitmap_diff~audit_pass_diff~5.1e-7~1e-9~"
global pvcache ulong 44
