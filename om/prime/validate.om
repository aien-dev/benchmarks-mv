fn pvcompare threads ulong to ulong
if not seq get pvline 0 scat pvlit 17 get pvexpect 0
ret 9
end
if not seq get pvline 4 get pvexpect 4
ret 9
end
if not seq get pvline 5 get pvexpect 5
ret 9
end
if ne get pvline 6 get pvexpect 6
ret 9
