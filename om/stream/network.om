r = lr_ready fd 1 deadline
if gt r 0
r = recv fd lr_dns 0 len lr_dns 0
end
if lt r 12
ret false
end
put lr_dnst 1 ulong r
ret true
end
fn lr_word line ulong want ulong to ulong
i = ulong 0
idx = ulong 0
while lt i slen line
while and lt i slen line swhite lr_char line i
i = add i 1
end
start = i
while and lt i slen line not swhite lr_char line i
if eq lr_char line i 35
ret ssub line 0 0
end
i = add i 1
end
if eq idx want
ret ssub line start sub i start
end
idx = add idx 1
end
ret ssub line 0 0
end
fn lr_resolvline line ulong to void
lr_nsline line
key = lr_word line 0
if or seq key lr_L 202 seq key lr_L 203
put lr_opts 0 0
for i ulong 6
word = lr_word line add i 1
if eq slen word 0
ret
end
put lr_srch i word
put lr_opts 0 add i 1
if seq key lr_L 203
ret
end
end
end
if seq key lr_L 204
for i ulong 32
word = lr_word line add i 1
if eq slen word 0
ret
end
lr_resolvopt word
end
end
end
fn lr_resolvopt word ulong to void
for i ulong 3
prefix = lr_L add 205 i
if sstarts word prefix
n = lr_number ssub word slen prefix sub slen word slen prefix
if lt n 0
ret
end
if eq i 0
if gt n 15
n = 15
end
put lr_opts 1 ulong n
end
if eq i 1
if and gt n 0 le n 5
put lr_opts 2 ulong n
end
end
if eq i 2
if and gt n 0 le n 30
put lr_opts 3 mul ulong n 1000000000
end
end
ret
end
end
if seq word lr_L 208
put lr_opts 4 1
end
end
fn lr_search_dns host ulong port ulong to bool
if eq lr_char host sub slen host 1 46
ret lr_dnsname host port
end
dots = ulong 0
for i ulong slen host
if eq lr_char host i 46
dots = add dots 1
end
end
first = ge dots get lr_opts 1
if first
if lr_dnsname host port
ret true
end
end
for i ulong get lr_opts 0
cand = scat3 host L_dot get lr_srch i
if lr_dnsname cand port
ret true
end
end
if not first
ret lr_dnsname host port
end
ret false
end
fn lr_dnsto to long
if eq get lr_opts 3 0
ret long get lr_cfg 12
end
ret long get lr_opts 3
end
fn lr_zonevalid zone ulong to bool
if or eq slen zone 0 gt slen zone 15
ret false
end
for i ulong slen zone
c = lr_char zone i
if not or and ge c 48 le c 57 and ge sf_hlower c 97 le sf_hlower c 122
if not or eq c 95 or eq c 45 eq c 46
ret false
end
end
end
ret true
end
