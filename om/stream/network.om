for i ulong n
sbyte get s i
end
ret sdone p
end
fn lr_ci a ulong b ulong to bool
if ne slen a slen b
ret false
end
for i ulong slen a
if ne sf_hlower lr_char a i sf_hlower lr_char b i
ret false
end
end
ret true
end
fn lr_hostline line ulong host ulong port ulong to bool
i = ulong 0
while and lt i slen line swhite lr_char line i
i = add i 1
end
start = i
while and lt i slen line not swhite lr_char line i
i = add i 1
end
addr = ssub line start sub i start
while lt i slen line
while and lt i slen line swhite lr_char line i
i = add i 1
end
start = i
while and lt i slen line not swhite lr_char line i
if eq lr_char line i 35
ret false
end
i = add i 1
end
if lr_ci ssub line start sub i start host
ret lr_literal addr port
end
end
ret false
end
fn lr_hosts_lookup host ulong port ulong to bool
p = get sp 0
file = fopen lr_hosts 0 len lr_hosts 524288 0
if lt file 0
ret false
