note IPv4 literal TCP client. Nonblocking sockets, checked monotonic deadlines.
note Configuration lr_cfg slots are defined in cli.om. Request bytes in lr_req.
global lr_addr uchar 28
global lr_opt uchar 4
global lr_req uchar 65536
global lr_net ulong 8
note lr_net: request length, measured request finish ns, last errno magnitude.
fn lr_ipv4 host ulong port ulong to bool
for i ulong len lr_addr
put lr_addr i 0
end
put lr_addr 0 2
put lr_addr 2 uchar shr port 8
put lr_addr 3 uchar and port 255
part = ulong 0
v = ulong 0
digits = ulong 0
for i ulong add slen host 1
c = uchar 46
if lt i slen host
c = lr_char host i
end
if eq c 46
if or eq digits 0 ge part 4
ret false
end
put lr_addr add part 4 uchar v
part = add part 1
v = 0
digits = 0
else
if or lt c 48 gt c 57
ret false
end
v = add mul v 10 ulong sub c 48
digits = add digits 1
if or gt v 255 gt digits 3
ret false
end
end
end
put lr_net 3 16
put lr_net 4 2
ret eq part 4
end
fn lr_ready fd int events int deadline long to long
while true
left = sub deadline monons
if le left 0
ret 0
end
r = waitio fd events left
if ne r -4
ret r
end
end
ret -4
end
fn lr_open to long
fd = socknew int get lr_net 4 526337 0
if lt fd 0
put lr_net 2 ulong neg fd
ret -1
end
deadline = add monons long get lr_cfg 12
r = connect int fd lr_addr 0 get lr_net 3
if eq r -115
r = lr_ready int fd 4 deadline
if le r 0
put lr_net 2 110
closed = fclose int fd
ret -1
end
note A second connect distinguishes a refused connection without getsockopt support.
r = connect int fd lr_addr 0 get lr_net 3
end
if and ne r 0 ne r -106
put lr_net 2 ulong neg r
closed = fclose int fd
ret -1
end
put lr_opt 0 1
r = sockopt int fd 6 1 lr_opt 0 len lr_opt
if ne r 0
put lr_net 2 ulong neg r
closed = fclose int fd
ret -1
end
ret fd
end
fn lr_send fd int to bool
p = ulong 0
deadline = add monons long get lr_cfg 13
while lt p get lr_net 0
r = send fd lr_req p sub get lr_net 0 p 0
if gt r 0
p = add p ulong r
deadline = add monons long get lr_cfg 13
else
if or eq r -11 eq r -4
ready = lr_ready fd 4 deadline
if le ready 0
put lr_net 2 110
ret false
end
else
if lt r 0
put lr_net 2 ulong neg r
else
put lr_net 2 32
end
ret false
end
end
end
ret true
end
fn lr_read fd int to void
deadline = add monons long get lr_cfg 13
while eq get ac_s 2 0
r = recv fd sf_fi 0 16384 0
at = monons
if gt r 0
ac_feed 0 ulong r ulong at
deadline = add at long get lr_cfg 13
else
if eq r 0
ac_eof
else
if or eq r -11 eq r -4
ready = lr_ready fd 1 deadline
if eq ready 0
ac_fail 4 110
end
if lt ready 0
ac_fail 3 ulong neg ready
end
else
ac_fail 3 ulong neg r
end
end
end
end
end
fn lr_measure index ulong to void
begin = monons
fd = long -1
if lr_resolve get lr_cfg 0 get lr_cfg 1
fd = lr_open
else
put lr_net 2 2
end
start = monons
ac_reset index ulong start
if lt fd 0
ac_fail 1 get lr_net 2
else
put ac_s 34 1
put ac_s 35 ulong sub start begin
if not lr_send int fd
ac_fail 2 get lr_net 2
else
lr_read int fd
end
closed = fclose int fd
end
put lr_net 1 ulong monons
outcome = ac_finish
end
global lr_v6 ushort 8
fn lr_ipv6 host ulong port ulong to bool
for j ulong 8
put lr_v6 j 0
end
i = ulong 0
n = slen host
group = ulong 0
hole = long -1
if lt n 2
ret false
end
if eq lr_char host 0 58
if ne lr_char host 1 58
ret false
end
hole = 0
i = 2
end
while lt i n
if ge group 8
ret false
end
start = i
while and lt i n ne lr_char host i 58
i = add i 1
end
part = ssub host start sub i start
if ge sfind part L_dot 0
if gt group 6
ret false
end
if not lr_ipv4 part port
ret false
end
lr_v4tail group
group = add group 2
if ne i n
ret false
end
else
value = lr_hexgroup part
if lt value 0
ret false
end
put lr_v6 group ushort value
group = add group 1
end
if lt i n
i = add i 1
if eq i n
ret false
end
if eq lr_char host i 58
if ge hole 0
ret false
end
hole = long group
i = add i 1
end
end
end
if ge hole 0
if ge group 8
ret false
end
shift = sub 8 group
for j ulong sub group ulong hole
src = sub sub group j 1
put lr_v6 add src shift get lr_v6 src
end
for j ulong shift
put lr_v6 add ulong hole j 0
end
else
if ne group 8
ret false
end
end
lr_v6addr port
ret true
end
fn lr_hexgroup part ulong to long
if or eq slen part 0 gt slen part 4
ret -1
end
v = ulong 0
for i ulong slen part
d = sf_hexval lr_char part i
if eq d 16
ret -1
end
v = add mul v 16 d
end
ret long v
end
fn lr_v6addr port ulong to void
for i ulong len lr_addr
put lr_addr i 0
end
put lr_addr 0 10
put lr_addr 2 uchar shr port 8
put lr_addr 3 uchar and port 255
for i ulong 8
v = get lr_v6 i
put lr_addr add 8 mul i 2 uchar shr v 8
put lr_addr add 9 mul i 2 uchar and v 255
end
put lr_net 3 28
put lr_net 4 10
end
fn lr_literal host ulong port ulong to bool
for i ulong slen host
if eq lr_char host i 58
ret lr_scoped6 host port
end
end
ret lr_ipv4 host port
end
