note Arithmetic oracle: frozen V8 binary64 results, generated outside the delivered runtime.
text dvpath "tests/fixtures/numerics/binary64.tsv"
global dv ulong 4
fn main to int
sinit
p = get sp 0
for i ulong len dvpath
sbyte get dvpath i
end
raw = ftext sdone p
if lt raw 0
ret 1
end
textval = ulong raw
p = ulong 0
while lt p slen textval
for k ulong 4
v = ulong 0
more = true
while and more lt p slen textval
c = schar textval p
p = add p 1
if or eq c 32 eq c 10
more = false
else
v = add mul v 10 ulong sub c 48
end
end
put dv k v
end
if not dfcheck
ret 2
end
end
ret 0
end
fn dfcheck to bool
op = get dv 0
a = get dv 1
b = get dv 2
want = get dv 3
got = ulong 0
if eq op 0
got = dfadd a b
end
if eq op 1
got = dfsub a b
end
if eq op 2
got = dfmul a b
end
if eq op 3
got = dfdiv a b
end
if eq op 4
got = dfsqrt a
end
if eq op 5
got = df_from_u64 a
end
if df_nan want
ret df_nan got
end
ret eq got want
end
