note Each line is expected acceptance (1 or 0), a separator, then JSON bytes.
text cases "1|null\n1|true\n1|false\n1|0\n1|-0\n1|1.5e+10\n1|-3E-2\n1|[]\n1|{}\n1| [ 1 , 2 ] \n1|{\"\":true,\"a\":{\"b\":[null,false]}}\n1|\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"\n1|\"\\u0000\\u007f\\u0080\\u07ff\\u0800\\uffff\"\n1|\"\\ud800\\udc00\\udbff\\udfff\"\n1|18446744073709551616\n1|1e9999\n0|\n0| \n0|[\n0|{\n0|[1,]\n0|[,1]\n0|{\"a\":1,}\n0|{\"a\" 1}\n0|{a:1}\n0|{\"a\":}\n0|[1 2]\n0|[1}\n0|{]\n0|true false\n0|truex\n0|nul\n0|False\n0|NaN\n0|Infinity\n0|+1\n0|01\n0|-01\n0|.1\n0|1.\n0|1e\n0|1e+\n0|--1\n0|\"\n0|\"\\x\"\n0|\"\\u123\"\n0|\"\\u12X4\"\n0|\"\\ud800\"\n0|\"\\udc00\"\n0|\"\\ud800\\u0041\"\n0|\"\\ud800x\"\n0|\"\\ud800\\x\"\n"
text object "{\"a\":[1,true,null,\"x\"],\"b\":false}"
fn rawstring first uchar second uchar third uchar fourth uchar size ulong want bool to bool
put jb 0 34
put jb 1 first
put jb 2 second
put jb 3 third
put jb 4 fourth
put jb add size 1 34
ret eq jparse add size 2 want
end
fn main to int
p = ulong 0
while lt p len cases
want = eq get cases p 49
p = add p 2
n = ulong 0
while ne get cases p 10
put jb n get cases p
n = add n 1
p = add p 1
end
if ne jparse n want
ret 1
end
if and not want ne get js 4 1
ret 2
end
p = add p 1
end
note Every proper prefix of this container is incomplete.
for i ulong len object
put jb i get object i
end
for i ulong len object
if jparse i
ret 3
end
end
if not jparse len object
ret 4
end
note UTF8 boundary vectors, overlong forms, surrogates, bad continuations and range.
if not rawstring 194 128 0 0 2 true
ret 5
end
if not rawstring 223 191 0 0 2 true
ret 6
end
if not rawstring 224 160 128 0 3 true
ret 7
end
if not rawstring 239 191 191 0 3 true
ret 8
end
if not rawstring 240 144 128 128 4 true
ret 9
end
if not rawstring 244 143 191 191 4 true
ret 10
end
if not rawstring 192 128 0 0 2 false
ret 11
end
if not rawstring 224 159 191 0 3 false
ret 12
end
if not rawstring 237 160 128 0 3 false
ret 13
end
if not rawstring 240 143 191 191 4 false
ret 14
end
if not rawstring 244 144 128 128 4 false
ret 15
end
if not rawstring 245 128 128 128 4 false
ret 16
end
if not rawstring 128 0 0 0 1 false
ret 17
end
if not rawstring 194 65 0 0 2 false
ret 18
end
if not rawstring 0 0 0 0 1 false
ret 19
end
if not rawstring 10 0 0 0 1 false
ret 20
end
if not rawstring 31 0 0 0 1 false
ret 21
end
note Only JSON's four whitespace characters are accepted outside strings.
put jb 0 11
put jb 1 48
if jparse 2
ret 22
end
put jb 0 9
put jb 1 13
put jb 2 10
put jb 3 32
put jb 4 48
if not jparse 5
ret 23
end
ret 0
end
