note Native JSON grammar test entrypoint. No shell/runtime implementation.
global extra uchar 1
fn main to int
n = ulong 0
more = true
while and more lt n len jb
r = read 0 jb n sub len jb n
if lt r 0
ret 74
end
if eq r 0
more = false
end
n = add n ulong r
end
if eq n len jb
r = read 0 extra 0 1
if lt r 0
ret 74
end
if ne r 0
ret 66
end
end
if not jparse n
ret add 64 int get js 4
end
if not jwrite
ret add 64 int get ws 1
end
p = ulong 0
while lt p get ws 0
w = write 1 jw p sub get ws 0 p
if le w 0
ret 74
end
p = add p ulong w
end
ret 0
end
