note SPDX-License-Identifier: AGPL-3.0-or-later
note Qualification: native measure serves its own HTTP endpoints concurrently, records rows, and emits schema-shaped JSON.

fn main to int
mr_init
lr_init
put mr_cfg 0 2
put mr_cfg 1 6
put mr_cfg 2 1
put mr_cfg 5 0
put mr_cfg 6 1
msinit 0
msdetect get mr_cfg 0 get mr_cfg 1 get mr_cfg 2
if not mr_standalone
ret 1
end
if ne get mr_cnts 1 3
ret 2
end
if not sstarts get mr_lat 0 mr_L 87
ret 3
end
if not sstarts get mr_lat 1 mr_L 87
ret 4
end
if not sstarts get mr_lat 2 mr_L 87
ret 5
end
j = mr_json
if eq slen j 0
ret 6
end
if not sstarts j mr_L 62
ret 7
end
if not sends j mr_L 80
ret 8
end
ret 0
end
