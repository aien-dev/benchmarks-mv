note File-backed capture handles simultaneous multi-megabyte stdout/stderr and child timeout.
text pxtprog "build/om/sweep-process-child"
fn main to int
sinit
pxinit
p = get sp 0
for i ulong len pxtprog
sbyte get pxtprog i
end
program = sdone p
if not pxrun program 10 L_empty 1 1000000000
ret 1
end
if ne get pxcode 0 7
ret 2
end
for i ulong 2
fd = fopenread get pxstate add i 1
if lt fd 0
ret 3
end
size = fseek int fd 0 2
closed = fclose int fd
if or ne size 2097152 ne closed 0
ret 4
end
end
if not pxrun program 11 L_empty 1 10000000
ret 5
end
if ne get pxcode 0 -9
ret 6
end
ret 0
end
