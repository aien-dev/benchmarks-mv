ret 5
end
put fi 0 1
r = write int fd fi 0 1
closed = fclose int fd
if ne pvvalidate 17
ret 6
end
if ne get pvresult 6 1
ret 7
end
if not pvtstart 3
ret 8
end
ok = pvtwrite get pxstate 1 pvt 8
if ne pvvalidate 2
ret 9
end
if not pvtstart 3
