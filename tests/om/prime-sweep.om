note Independent exhaustive set membership oracle using trial division, not Miller-Rabin.
text swtdata " 5,1,3..5,,+2, 1 |18446744073709551615|18446744073709551614..18446744073709551615|x|2..1|1 ..2|1.. 2|1..2..3|18446744073709551616|,,,|+|0..4096|  2 　,1"
fn swtinput index ulong to ulong
p = get sp 0
part = ulong 0
for i ulong len swtdata
c = get swtdata i
if eq c 124
if eq part index
ret sdone p
end
part = add part 1
else
if eq part index
sbyte c
end
end
end
ret sdone p
end
fn swtprime n ulong to bool
if lt n 2
ret false
end
d = ulong 2
while le d div n d
if eq rem n d 0
ret false
end
d = add d 1
end
ret true
end
fn swtwant n ulong root ulong to bool
if or le n 5 or eq n 8 eq n 9
ret true
end
if or eq n 15 or eq n 25 eq n 121
ret true
end
if or eq n 169 or eq n 289 eq n 361
ret true
end
if or eq n 961 eq n 1000000
ret true
end
if or and ge n 31 le n 34 and ge n 63 le n 66
ret true
end
if or and ge n 95 le n 97 and ge n 127 le n 130
ret true
end
if or and ge n 255 le n 258 and ge n 1023 le n 1025
ret true
end
if or and ge n 1999 le n 2001 and ge n 4095 le n 4097
ret true
end
if and ge n 999983 le n 1000003
ret true
end
if and ge n 127 le n 2049
if or le rem n 128 1 eq rem n 128 127
ret true
end
end
if and ge n 2047 le n 32769
if or le rem n 2048 1 eq rem n 2048 2047
ret true
end
end
if and le root 997 swtprime root
if le sub n mul root root 1
ret true
end
end
next = add root 1
if and le next 997 swtprime next
if eq add n 1 mul next next
ret true
end
end
ret false
end
fn main to int
sinit
if ne swdefault 0
ret 1
end
root = ulong 0
index = ulong 0
for chunk ulong 3
for offset ulong 400000
n = add mul chunk 400000 offset
if le n 1000003
if le mul add root 1 add root 1 n
root = add root 1
end
if swtwant n root
if ge index get swstate 0
ret 2
end
if ne get swvalues index n
ret 3
end
index = add index 1
end
end
end
end
if ne index get swstate 0
ret 4
end
swrite 1 suint index
swrite 1 L_newline
if ne swparse swtinput 0 0
ret 5
end
if ne get swstate 0 5
ret 6
end
for i ulong 5
if ne get swvalues i add i 1
ret 7
end
end
if ne swparse swtinput 1 0
ret 8
end
if ne get swvalues 0 ulong 18446744073709551615
ret 9
end
if ne swparse swtinput 2 0
ret 10
end
if ne get swstate 0 2
ret 11
end
if ne get swvalues 0 ulong 18446744073709551614
ret 12
end
if ne get swvalues 1 ulong 18446744073709551615
ret 13
end
expected = new ulong 10 1
put expected 1 2
put expected 6 3
put expected 8 4
put expected 9 0
for i ulong 10
if ne swparse swtinput add i 3 get expected i
ret int add i 20
end
end
if ne get swstate 0 2
ret 40
end
note Check the exact successful capacity boundary independently of the overflowing range.
put swstate 0 0
if not swrange 0 4095
ret 41
end
if ne get swstate 0 4096
ret 42
end
if not swinsert 4095
ret 43
end
if swinsert 4096
ret 44
end
ret 0
end
