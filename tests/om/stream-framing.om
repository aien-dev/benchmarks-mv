note Native framing contract tests. No network or clocks, all timestamps supplied.
text raw "HTTP/1.1 200 OK\nContent-Type: text/event-stream\nTransfer-Encoding: chunked\n\n6\ndata: \n7;ext=1\nhello\n\n\n0\nX-Trailer: y\n\n"
text body "data: hello\n\n"
text coal "data: one\n\n: keep-alive\ndata: two\n\nevent: x\ndata: a\ndata: b\n\n"
text leng "HTTP/1.1 500 Internal Server Error\nContent-Length: 10\n\nboom!!!!!!extra"
text close "HTTP/1.0 201 OK\n\ndata: a\n\n"
text bad "SSH-2.0-x\n\n"
text bcl "HTTP/1.1 200 OK\nContent-Length: x\n\n"
text bsz "HTTP/1.1 200 OK\nTransfer-Encoding: chunked\n\nzz\n"
text bterm "HTTP/1.1 200 OK\nTransfer-Encoding: chunked\n\n2\nabXX\n"
text many "garbage line\nfoo: bar\nid: x\nretry: 12\nevent: x\n\n"
text fields "data\ndata: \ndata:  a\nevent:\n\n"
text dup "HTTP/1.1 204 OK\nContent-Length: +0\nTransfer-Encoding: chunked\nTransfer-Encoding: identity\n\n"
text mixed "HTTP/1.1 200 OK\nTransfer-Encoding: GZIP, CHUNKED \nContent-Length: 99\n\n+0;ok\n\n"
fn ck ok bool code int to void
if not ok
exit code
end
end
fn split_http to void
n = ulong 0
for i ulong len raw
c = get raw i
put sf_fi n c
n = add n 1
end
note Every possible two-read split must produce identical decoded bytes.
for split ulong add n 1
sf_hreset
ck sf_hfeed 0 split 1
ck sf_hfeed split sub n split 2
ck sf_heof 3
ck sf_hsuccess 4
ck eq get sf_hs 8 len body 5
ck eq get sf_hs 3 200 6
ck eq get sf_hs 11 17 7
for j ulong len body
ck eq get sf_ho j get body j 8
end
end
end
fn split_sse to void
for i ulong len coal
put sf_fi i get coal i
end
for split ulong add len coal 1
sf_sreset
ck sf_sfeed 0 split 10 0 10
prev = get sf_ss 10
ck sf_sfeed split sub len coal split 90 1 11
ck eq get sf_ss 10 3 12
ck eq get sf_ss 6 1 13
ck eq get sf_sz 0 3 14
ck eq get sf_sz 1 3 15
ck eq get sf_sz 2 3 16
ck eq get sf_sn 2 1 17
ck eq get sf_sk 2 1 18
ck eq get sf_so add get sf_sa 2 1 10 19
for j ulong 3
if lt j prev
ck eq get sf_st j 10 20
ck eq get sf_si j 0 21
else
ck eq get sf_st j 90 22
ck eq get sf_si j 1 23
end
end
ck not sf_spending 24
end
end
fn lengths to void
sf_hreset
for i ulong len leng
put sf_fi i get leng i
end
n = sub len leng 10
ck sf_hfeed 0 n 25
ck not sf_heof 26
ck not sf_hsuccess 27
ck sf_hfeed n 10 28
ck sf_heof 29
ck eq get sf_hs 8 10 30
sf_hreset
for i ulong len close
put sf_fi i get close i
end
ck sf_hfeed 0 len close 31
ck sf_heof 32
ck eq get sf_hs 7 0 33
sf_hreset
for i ulong len dup
put sf_fi i get dup i
end
ck sf_hfeed 0 len dup 34
ck sf_heof 35
ck eq get sf_hs 4 1 36
sf_hreset
for i ulong len mixed
put sf_fi i get mixed i
end
ck sf_hfeed 0 len mixed 37
ck sf_heof 38
ck eq get sf_hs 4 2 39
end
fn malformed to void
sf_hreset
for i ulong len bad
put sf_fi i get bad i
end
ck not sf_hfeed 0 len bad 40
ck eq get sf_hs 0 2 41
sf_hreset
for i ulong len bcl
put sf_fi i get bcl i
end
ck not sf_hfeed 0 len bcl 42
ck eq get sf_hs 0 3 43
sf_hreset
for i ulong len bsz
put sf_fi i get bsz i
end
ck not sf_hfeed 0 len bsz 44
ck eq get sf_hs 0 4 45
sf_hreset
for i ulong len bterm
put sf_fi i get bterm i
end
ck not sf_hfeed 0 len bterm 46
ck eq get sf_hs 0 5 47
sf_sreset
for i ulong len many
put sf_fi i get many i
end
ck sf_sfeed 0 len many 0 0 48
ck eq get sf_ss 7 2 49
ck eq get sf_ss 9 1 50
ck eq get sf_ss 10 0 51
put sf_fi 0 255
put sf_fi 1 254
put sf_fi 2 10
ck sf_sfeed 0 3 0 0 52
ck eq get sf_ss 8 1 53
end
fn crlf to void
sf_sreset
n = ulong 0
for i ulong len fields
c = get fields i
if eq c 10
put sf_fi n 13
n = add n 1
end
put sf_fi n c
n = add n 1
end
for i ulong n
ck sf_sfeed i 1 100 i 54
end
ck eq get sf_ss 10 1 55
ck eq get sf_sz 0 4 56
ck eq get sf_sk 0 1 57
ck eq get sf_sn 0 0 58
ck eq get sf_st 0 100 59
ck eq get sf_si 0 sub n 1 60
sf_hreset
n = ulong 0
for i ulong len close
c = get close i
if eq c 10
put sf_fi n 13
n = add n 1
end
put sf_fi n c
n = add n 1
end
for i ulong n
ck sf_hfeed i 1 61
end
ck sf_heof 62
ck sf_hsuccess 63
end
fn limits to void
sf_hreset
for i ulong 65537
put sf_fi i 97
end
ck not sf_hfeed 0 65537 64
ck eq get sf_hs 0 1 65
sf_sreset
for i ulong 600000
put sf_fi i 97
end
ck sf_sfeed 0 600000 0 0 66
ck sf_sfeed 0 448576 0 0 67
put sf_fi 0 10
ck sf_sfeed 0 1 0 0 68
ck eq get sf_ss 7 1 69
sf_sreset
put sf_fi 0 97
ck sf_sfeed 0 600000 0 0 70
ck sf_sfeed 0 448576 0 0 71
ck not sf_sfeed 0 1 0 0 72
ck eq get sf_ss 0 7 73
sf_hreset
for i ulong len bsz
put sf_fi i get bsz i
end
ck sf_hfeed 0 sub len bsz 3 74
for i ulong 4097
put sf_fi i 97
end
ck not sf_hfeed 0 4097 75
ck eq get sf_hs 0 6 76
sf_hreset
ck not sf_hfeed 1000000 1 77
ck eq get sf_hs 0 8 78
sf_sreset
ck not sf_sfeed 1000000 1 0 0 79
ck eq get sf_ss 0 8 80
end
fn main to int
split_http
split_sse
lengths
malformed
crlf
limits
ret 0
end
