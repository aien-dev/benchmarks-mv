note Real local transport qualification only. Fixture outputs are not model benchmarks.
text lr_reply "HTTP/1.1 200 OK\nContent-Type: text/event-stream\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"fixture\"}}]}\n\ndata: {\"usage\":{\"completion_tokens\":7,\"prompt_tokens\":3}}\n\ndata: [DONE]\n\n"
text lr_nouse "HTTP/1.1 200 OK\n\ndata: {\"choices\":[{\"text\":\"fixture\"}]}\n\ndata: [DONE]\n\n"
text lr_error "HTTP/1.1 500 Failed\nContent-Length: 4\n\nboom"
text lr_out "build/om/stream/fixture-runs"
text lr_prmt "Quote \"this\"\nline"
text lr_msgs "messages"
text lr_ct "content"
text lr_check "metrics.ttft_ms_samples~metrics.ttft_ms_p95~methodology.token_accounting~build.compiler~build.rustc~metrics.output_tokens_total~samples~warmup~"
global lr_cfd long 4
global lr_cks ulong 8
fn lr_ck ok bool code int to void
if not ok
exit code
end
end
fn lr_testinit to void
p = get sp 0
for i ulong len lr_out
sbyte get lr_out i
end
put lr_cfg 15 sdone p
p = get sp 0
for i ulong len lr_prmt
sbyte get lr_prmt i
end
put lr_cfg 8 sdone p
p = get sp 0
n = ulong 0
for i ulong len lr_check
c = get lr_check i
if eq c 126
put lr_cks n sdone p
n = add n 1
p = get sp 0
else
sbyte c
end
end
end
fn lr_checkrequest fd int to void
n = ulong 0
deadline = add monons 3000000000
while lt n get lr_net 0
lr_ck gt lr_ready fd 1 deadline 0 80
r = recv fd sf_fi n sub get lr_net 0 n 0
lr_ck gt r 0 81
n = add n ulong r
end
i = ulong 0
while lt i n
if eq get sf_fi i 123
lr_checkbody i sub n i
ret
end
i = add i 1
end
exit 82
end
fn lr_checkbody off ulong n ulong to void
for i ulong n
put jb i get sf_fi add off i
end
lr_ck jparse n 83
lr_ck jsame jlookup 0 lr_L 110 get lr_cfg 3 84
p = get sp 0
for i ulong len lr_msgs
sbyte get lr_msgs i
end
msgs = jlookup 0 sdone p
lr_ck jkind msgs 2 85
p = get sp 0
for i ulong len lr_ct
sbyte get lr_ct i
end
value = jlookup add msgs 1 sdone p
lr_ck jsame value get lr_cfg 8 86
end
fn lr_group server int count ulong to void
for i ulong count
lr_ck gt lr_ready server 1 add monons 3000000000 0 87
fd = accept server 524288
lr_ck ge fd 0 88
put lr_cfd i fd
lr_checkrequest int fd
end
note Respond only once all workers in this group have connected and sent a request.
for i ulong count
fd = int get lr_cfd i
if eq i 0
r = send fd lr_reply 0 len lr_reply 0
lr_ck eq r long len lr_reply 89
end
if eq i 1
r = send fd lr_nouse 0 len lr_nouse 0
lr_ck eq r long len lr_nouse 89
end
if eq i 2
r = send fd lr_error 0 len lr_error 0
lr_ck eq r long len lr_error 89
end
r = fclose fd
end
end
fn lr_fixture server int to void
lr_group server 3
r = fclose server
exit 0
end
fn lr_validate_run to void
lr_ck eq get lr_sum 0 2 20
lr_ck eq get lr_sum 1 2 21
lr_ck eq get lr_sum 4 1 22
lr_ck eq get lr_sum 5 7 23
lr_ck eq get lr_sum 8 0 24
lr_ck gt get lr_meta 8 0 25
record = spath get lr_cfg 15 get lr_meta 7
lr_ck jread record 26
lr_ck junsigned jpath 0 get lr_cks 0 27
lr_ck eq get js 5 2 28
lr_ck lt jpath 0 get lr_cks 1 0 29
lr_ck jsame jpath 0 get lr_cks 2 lr_L 58 30
lr_ck jkind jpath 0 get lr_cks 3 3 31
lr_ck lt jpath 0 get lr_cks 4 0 32
lr_ck lt jpath 0 get lr_cks 5 0 33
lr_ck eq get lr_fail 7 1 34
raw = spath get lr_cfg 15 get lr_meta 6
lr_ck jread raw 35
lr_ck eq jlistcount jpath 0 get lr_cks 6 3 36
lr_ck eq jlistcount jpath 0 get lr_cks 7 0 37
end
fn main to int
sinit
ac_init
lr_init
lr_testinit
put lr_cfg 9 3
put lr_cfg 10 3
put lr_cfg 11 0
put lr_cfg 12 1000000000
put lr_cfg 13 1000000000
lr_ck lr_ipv4 lr_L 0 0 1
server = socknew 2 526337 0
lr_ck ge server 0 2
r = bind int server lr_addr 0 16
lr_ck eq r 0 3
r = listen int server 8
lr_ck eq r 0 4
r = sockname int server lr_addr 0 len lr_addr
lr_ck gt r 0 5
put lr_cfg 1 or shl ulong get lr_addr 2 8 ulong get lr_addr 3
lr_ck lr_source 6
lr_hardware
lr_gpu
lr_ck lr_request 7
pid = fork
lr_ck ge pid 0 8
if eq pid 0
lr_fixture int server
end
lr_ck lr_run_all 9
r = waitpid int pid pstatus 0 len pstatus 0
lr_ck eq r pid 10
lr_ck eq pcode 0 11
r = fclose int server
lr_validate_run
ret 0
end
